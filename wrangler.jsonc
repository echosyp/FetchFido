// Cloudflare deployment of the hosted FetchFido (docs/TODO.md items 2 and 3).
//
// The API is the same Go code as the self-hosted binary, compiled to
// WebAssembly (cmd/worker) and run by the generated shim in build/. The PWA is
// served from web/ by the Worker's static-assets binding; only /api/* reaches
// the WASM. Build with `make worker`.
//
// Before the first deploy, create the database and paste its id below:
//   npx wrangler@4 d1 create fetchfido
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fetchfido",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "make worker"
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fetchfido",
      "database_id": "3d0b50e9-cc42-4ee3-8065-caea631d8495"
    }
  ],
  "vars": {
    "AUTH_MODE": "accounts",
    "REGISTRATION": "open",
    "RETENTION_DAYS": "30"
  },
  "observability": {
    "enabled": true
  }
}
