# Cloudflare Pages response headers.
#
# These complement the meta CSP in index.html. frame-ancestors in particular is
# IGNORED when delivered via <meta> and only works as a real header, so this is
# the only place it can be set.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin

# A cached service worker cannot update itself, which strands every visitor on
# whatever build they first loaded. This project has already lost hours to
# exactly that failure locally.
/sw.js
  Cache-Control: no-cache, must-revalidate

# The app shell changes on every deploy; let the service worker own caching
# rather than the CDN, so a stale edge copy cannot outlive an update.
/index.html
  Cache-Control: no-cache, must-revalidate

/js/*
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate

# Vendored Leaflet is version-pinned and hash-verified, so it can cache hard.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
